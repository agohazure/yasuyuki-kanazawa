---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Contact" description="Contact photographer Yasuyuki Kanazawa for commissions and enquiries.">
	<main id="main-content" class="page contact-page container reveal">
		<header class="page-header page-header--compact">
			<p class="eyebrow">Enquiries &amp; commissions</p>
			<h1>Contact</h1>
		</header>

		<div class="contact-list">
			<div class="contact-row">
				<p>Email</p>
				<a href="mailto:info@demon-pictures.net">info@demon-pictures.net</a>
			</div>
			<div class="contact-row">
				<p>Instagram</p>
				<a href="https://www.instagram.com/yasuyuki_kanazawa/" rel="me noreferrer">@yasuyuki_kanazawa</a>
			</div>
		</div>
	</main>
</BaseLayout>
