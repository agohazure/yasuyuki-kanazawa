---
import WorkFigure from '../../components/WorkFigure.astro';
import ManagedGallery from '../../components/ManagedGallery.astro';
import { categories, type WorkCategory } from '../../data/works';
import BaseLayout from '../../layouts/BaseLayout.astro';

export function getStaticPaths() {
	return categories.map((category) => ({
		params: { category: category.slug },
		props: { category },
	}));
}

const { category } = Astro.props as { category: WorkCategory };
---

<BaseLayout title={category.title} description={`${category.description} Photography by Yasuyuki Kanazawa.`}>
	<main id="main-content" class="work-page page container reveal">
		<nav class="work-breadcrumb" aria-label="Breadcrumb">
			<ol>
				<li><a href="/#works">WORKS</a></li>
				<li aria-hidden="true">/</li>
				<li aria-current="page"><h1>{category.title}</h1></li>
			</ol>
		</nav>

		<div class="work-gallery" data-managed-gallery={category.slug}>
			{category.works.map((work, index) => <WorkFigure work={work} index={index + 1} priority={index === 0} />)}
		</div>
	</main>
	<ManagedGallery />
</BaseLayout>
