---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About" description="About Yasuyuki Kanazawa, a photographer based in Maxilla, Tokyo, Japan.">
	<main id="main-content" class="page container reveal">
		<header class="page-header page-header--compact">
			<p class="eyebrow">Profile</p>
			<h1>About</h1>
		</header>

		<section class="profile" aria-labelledby="profile-name">
			<p class="profile__index">01</p>
			<div>
				<h2 id="profile-name">Yasuyuki Kanazawa</h2>
				<p>
					Photographer based in
					<a class="inline-link" href="https://www.instagram.com/maxillajp/" target="_blank" rel="noopener noreferrer">Maxilla</a>,
					Tokyo, Japan.
				</p>
			</div>
		</section>
	</main>
</BaseLayout>
