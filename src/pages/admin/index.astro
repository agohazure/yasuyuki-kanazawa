---
import '../../styles/global.css';
import '../../styles/admin.css';
---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex, nofollow" />
		<meta name="theme-color" content="#f4f4f0" />
		<title>Photo Manager | Yasuyuki Kanazawa</title>
	</head>
	<body class="admin-body">
		<header class="admin-header">
			<a href="/">Yasuyuki Kanazawa</a>
			<span>Photo Manager</span>
		</header>

		<main class="admin-main">
			<section class="admin-login" data-login-panel>
				<div>
					<p class="admin-kicker">Private access</p>
					<h1>Photo Manager</h1>
					<p class="admin-intro">写真の追加、カテゴリー設定、掲載順の変更ができます。</p>
				</div>
				<form class="admin-login__form" data-login-form>
					<label for="admin-password">Password</label>
					<input id="admin-password" name="password" type="password" autocomplete="current-password" required />
					<button type="submit">Log in</button>
					<p class="admin-status" data-login-status aria-live="polite"></p>
				</form>
			</section>

			<section class="admin-workspace" data-workspace hidden>
				<div class="admin-toolbar">
					<div>
						<p class="admin-kicker">Portfolio library</p>
						<h1>Photographs</h1>
					</div>
					<div class="admin-toolbar__actions">
						<a href="/" target="_blank" rel="noopener noreferrer">View site</a>
						<button type="button" data-logout>Log out</button>
					</div>
				</div>

				<section class="upload-panel" aria-labelledby="upload-title">
					<div>
						<p class="admin-index">01</p>
						<h2 id="upload-title">Upload</h2>
					</div>
					<form class="upload-form" data-upload-form>
						<label class="upload-drop" for="photo-files">
							<span>Select photographs</span>
							<small>JPEG / PNG / WebP / AVIF · 複数選択可</small>
						</label>
						<input id="photo-files" class="visually-hidden" name="files" type="file" accept="image/jpeg,image/png,image/webp,image/avif" multiple required />
						<p class="upload-selection" data-file-selection>写真を選択してください</p>

						<fieldset class="tag-fieldset">
							<legend>Category tags</legend>
							<label><input type="checkbox" name="upload-tag" value="portrait" /> Portrait</label>
							<label><input type="checkbox" name="upload-tag" value="commercial" /> Commercial</label>
							<label><input type="checkbox" name="upload-tag" value="landscape" /> Landscape</label>
							<label><input type="checkbox" name="upload-tag" value="documentary" /> Documentary</label>
						</fieldset>

						<button class="admin-primary" type="submit">Upload &amp; publish</button>
						<p class="admin-status" data-upload-status aria-live="polite"></p>
					</form>
				</section>

				<section class="library-panel" aria-labelledby="library-title">
					<div class="library-heading">
						<div>
							<p class="admin-index">02</p>
							<h2 id="library-title">Library</h2>
						</div>
						<p class="library-count" data-library-count></p>
					</div>

					<div class="library-filters" role="group" aria-label="Filter photographs">
						<button type="button" class="is-active" data-filter="all">All</button>
						<button type="button" data-filter="portrait">Portrait</button>
						<button type="button" data-filter="commercial">Commercial</button>
						<button type="button" data-filter="landscape">Landscape</button>
						<button type="button" data-filter="documentary">Documentary</button>
					</div>
					<p class="library-help" data-library-help>カテゴリーを選ぶと、矢印で掲載順を変更できます。</p>
					<p class="admin-status" data-library-status aria-live="polite"></p>
					<div class="photo-library" data-photo-library></div>
				</section>
			</section>
		</main>

		<script>
			type Tag = 'portrait' | 'commercial' | 'landscape' | 'documentary';
			type AdminPhoto = {
				id: string;
				filename: string;
				title: string;
				alt: string;
				image: string;
				width: number;
				height: number;
				aspect: 'portrait' | 'landscape' | 'square';
				published: boolean;
				tags: Tag[];
				positions: Partial<Record<Tag, number>>;
				createdAt: string;
			};

			const tags: Tag[] = ['portrait', 'commercial', 'landscape', 'documentary'];
			const tagLabels: Record<Tag, string> = {
				portrait: 'Portrait',
				commercial: 'Commercial',
				landscape: 'Landscape',
				documentary: 'Documentary',
			};
			const state: { photos: AdminPhoto[]; filter: 'all' | Tag } = { photos: [], filter: 'all' };

			const loginPanel = document.querySelector<HTMLElement>('[data-login-panel]')!;
			const workspace = document.querySelector<HTMLElement>('[data-workspace]')!;
			const loginForm = document.querySelector<HTMLFormElement>('[data-login-form]')!;
			const loginStatus = document.querySelector<HTMLElement>('[data-login-status]')!;
			const uploadForm = document.querySelector<HTMLFormElement>('[data-upload-form]')!;
			const fileInput = document.querySelector<HTMLInputElement>('#photo-files')!;
			const fileSelection = document.querySelector<HTMLElement>('[data-file-selection]')!;
			const uploadStatus = document.querySelector<HTMLElement>('[data-upload-status]')!;
			const libraryStatus = document.querySelector<HTMLElement>('[data-library-status]')!;
			const library = document.querySelector<HTMLElement>('[data-photo-library]')!;
			const libraryCount = document.querySelector<HTMLElement>('[data-library-count]')!;

			function setStatus(target: HTMLElement, message = '', error = false) {
				target.textContent = message;
				target.classList.toggle('is-error', error);
			}

			async function requestJson<T>(url: string, options: RequestInit = {}) {
				const response = await fetch(url, { ...options, credentials: 'same-origin' });
				const payload = (await response.json().catch(() => ({}))) as T & { error?: string };
				if (!response.ok) throw new Error(payload.error || '処理を完了できませんでした。');
				return payload;
			}

			function showLogin() {
				loginPanel.hidden = false;
				workspace.hidden = true;
			}

			function showWorkspace() {
				loginPanel.hidden = true;
				workspace.hidden = false;
			}

			function element<K extends keyof HTMLElementTagNameMap>(tag: K, className?: string, text?: string) {
				const node = document.createElement(tag);
				if (className) node.className = className;
				if (text !== undefined) node.textContent = text;
				return node;
			}

			function visiblePhotos() {
				if (state.filter === 'all') {
					return [...state.photos].sort((left, right) => right.createdAt.localeCompare(left.createdAt));
				}
				return state.photos
					.filter((photo) => photo.tags.includes(state.filter as Tag))
					.sort(
						(left, right) =>
							(left.positions[state.filter as Tag] ?? Number.MAX_SAFE_INTEGER) -
							(right.positions[state.filter as Tag] ?? Number.MAX_SAFE_INTEGER),
					);
			}

			function makeTagCheckbox(photo: AdminPhoto, tag: Tag) {
				const label = element('label', 'photo-tag');
				const input = document.createElement('input');
				input.type = 'checkbox';
				input.value = tag;
				input.checked = photo.tags.includes(tag);
				input.dataset.cardTag = tag;
				label.append(input, document.createTextNode(tagLabels[tag]));
				return label;
			}

			function makeLabeledInput(labelText: string, value: string, field: 'title' | 'alt') {
				const label = element('label', 'photo-field');
				label.append(element('span', '', labelText));
				const input = document.createElement('input');
				input.type = 'text';
				input.value = value;
				input.dataset.field = field;
				input.maxLength = field === 'title' ? 120 : 240;
				label.append(input);
				return label;
			}

			function renderLibrary() {
				const photos = visiblePhotos();
				library.replaceChildren();
				libraryCount.textContent = `${photos.length} photograph${photos.length === 1 ? '' : 's'}`;

				if (photos.length === 0) {
					library.append(element('p', 'library-empty', 'まだ写真がありません。上のUploadから追加してください。'));
					return;
				}

				photos.forEach((photo, index) => {
					const card = element('article', 'photo-card');
					card.dataset.photoId = photo.id;

					const media = element('div', 'photo-card__media');
					const image = document.createElement('img');
					image.src = photo.image;
					image.alt = photo.alt;
					image.loading = 'lazy';
					media.append(image);
					if (!photo.published) media.append(element('span', 'photo-card__hidden', 'Hidden'));

					const body = element('div', 'photo-card__body');
					body.append(element('p', 'photo-card__filename', photo.filename || photo.id));
					body.append(makeLabeledInput('Title / Caption', photo.title, 'title'));
					body.append(makeLabeledInput('Image description', photo.alt, 'alt'));

					const tagGroup = element('fieldset', 'photo-card__tags');
					const legend = document.createElement('legend');
					legend.textContent = 'Category tags';
					tagGroup.append(legend, ...tags.map((tag) => makeTagCheckbox(photo, tag)));
					body.append(tagGroup);

					const visibility = element('label', 'photo-visibility');
					const published = document.createElement('input');
					published.type = 'checkbox';
					published.checked = photo.published;
					published.dataset.field = 'published';
					visibility.append(published, document.createTextNode(' Published'));
					body.append(visibility);

					const actions = element('div', 'photo-card__actions');
					if (state.filter !== 'all') {
						const previous = element('button', 'photo-order', '↑');
						previous.type = 'button';
						previous.title = 'Move earlier';
						previous.disabled = index === 0;
						previous.addEventListener('click', () => movePhoto(photo.id, -1));
						const next = element('button', 'photo-order', '↓');
						next.type = 'button';
						next.title = 'Move later';
						next.disabled = index === photos.length - 1;
						next.addEventListener('click', () => movePhoto(photo.id, 1));
						actions.append(previous, next);
					}

					const save = element('button', 'photo-save', 'Save');
					save.type = 'button';
					save.addEventListener('click', () => savePhoto(card, photo));
					const remove = element('button', 'photo-delete', 'Delete');
					remove.type = 'button';
					remove.addEventListener('click', () => deletePhoto(photo));
					actions.append(save, remove);

					body.append(actions);
					card.append(media, body);
					library.append(card);
				});
			}

			async function loadPhotos() {
				const payload = await requestJson<{ photos: AdminPhoto[] }>('/api/admin/photos');
				state.photos = payload.photos;
				renderLibrary();
			}

			async function savePhoto(card: HTMLElement, photo: AdminPhoto) {
				setStatus(libraryStatus, 'Saving…');
				const title = card.querySelector<HTMLInputElement>('[data-field="title"]')!.value;
				const alt = card.querySelector<HTMLInputElement>('[data-field="alt"]')!.value;
				const published = card.querySelector<HTMLInputElement>('[data-field="published"]')!.checked;
				const selectedTags = [...card.querySelectorAll<HTMLInputElement>('[data-card-tag]:checked')].map((input) => input.value as Tag);

				try {
					const payload = await requestJson<{ photo: AdminPhoto }>(`/api/admin/photos/${photo.id}`, {
						method: 'PATCH',
						headers: { 'content-type': 'application/json' },
						body: JSON.stringify({ title, alt, published, tags: selectedTags }),
					});
					state.photos = state.photos.map((item) => (item.id === photo.id ? payload.photo : item));
					setStatus(libraryStatus, 'Saved. The public site has been updated.');
					renderLibrary();
				} catch (error) {
					setStatus(libraryStatus, error instanceof Error ? error.message : '保存できませんでした。', true);
				}
			}

			async function deletePhoto(photo: AdminPhoto) {
				if (!window.confirm('この写真を完全に削除しますか？')) return;
				setStatus(libraryStatus, 'Deleting…');
				try {
					await requestJson(`/api/admin/photos/${photo.id}`, { method: 'DELETE' });
					state.photos = state.photos.filter((item) => item.id !== photo.id);
					setStatus(libraryStatus, 'Deleted.');
					renderLibrary();
				} catch (error) {
					setStatus(libraryStatus, error instanceof Error ? error.message : '削除できませんでした。', true);
				}
			}

			async function movePhoto(id: string, direction: -1 | 1) {
				if (state.filter === 'all') return;
				const ordered = visiblePhotos();
				const currentIndex = ordered.findIndex((photo) => photo.id === id);
				const destination = currentIndex + direction;
				if (currentIndex < 0 || destination < 0 || destination >= ordered.length) return;
				[ordered[currentIndex], ordered[destination]] = [ordered[destination], ordered[currentIndex]];
				setStatus(libraryStatus, 'Reordering…');

				try {
					await requestJson('/api/admin/order', {
						method: 'POST',
						headers: { 'content-type': 'application/json' },
						body: JSON.stringify({ tag: state.filter, ids: ordered.map((photo) => photo.id) }),
					});
					ordered.forEach((photo, index) => {
						photo.positions[state.filter as Tag] = index;
					});
					setStatus(libraryStatus, 'Order updated.');
					renderLibrary();
				} catch (error) {
					setStatus(libraryStatus, error instanceof Error ? error.message : '順番を変更できませんでした。', true);
				}
			}

			async function decodeImage(file: File) {
				const url = URL.createObjectURL(file);
				try {
					const image = new Image();
					image.src = url;
					if ('decode' in image) await image.decode();
					else await new Promise<void>((resolve, reject) => {
						image.onload = () => resolve();
						image.onerror = () => reject(new Error('画像を読み込めませんでした。'));
					});
					return image;
				} catch (error) {
					URL.revokeObjectURL(url);
					throw error;
				}
			}

			async function optimizeImage(file: File) {
				const image = await decodeImage(file);
				const sourceUrl = image.src;
				try {
					const longestSide = Math.max(image.naturalWidth, image.naturalHeight);
					const scale = Math.min(1, 3200 / longestSide);
					const width = Math.max(1, Math.round(image.naturalWidth * scale));
					const height = Math.max(1, Math.round(image.naturalHeight * scale));
					const canvas = document.createElement('canvas');
					canvas.width = width;
					canvas.height = height;
					const context = canvas.getContext('2d');
					if (!context) throw new Error('画像を処理できませんでした。');
					context.drawImage(image, 0, 0, width, height);
					const blob = await new Promise<Blob>((resolve, reject) => {
						canvas.toBlob((result) => (result ? resolve(result) : reject(new Error('画像を変換できませんでした。'))), 'image/webp', 0.9);
					});
					return { blob, width, height, filename: file.name.replace(/\.[^.]+$/, '') + '.webp' };
				} finally {
					URL.revokeObjectURL(sourceUrl);
				}
			}

			fileInput.addEventListener('change', () => {
				const count = fileInput.files?.length ?? 0;
				fileSelection.textContent = count ? `${count} photograph${count === 1 ? '' : 's'} selected` : '写真を選択してください';
			});

			uploadForm.addEventListener('submit', async (event) => {
				event.preventDefault();
				const files = [...(fileInput.files ?? [])];
				const selectedTags = [...uploadForm.querySelectorAll<HTMLInputElement>('[name="upload-tag"]:checked')].map((input) => input.value as Tag);
				if (files.length === 0) return setStatus(uploadStatus, '写真を選択してください。', true);
				if (selectedTags.length === 0) return setStatus(uploadStatus, 'カテゴリーを1つ以上選択してください。', true);

				const submit = uploadForm.querySelector<HTMLButtonElement>('button[type="submit"]')!;
				submit.disabled = true;
				let completed = 0;
				try {
					for (const file of files) {
						setStatus(uploadStatus, `${completed + 1} / ${files.length} — optimizing ${file.name}`);
						const optimized = await optimizeImage(file);
						const form = new FormData();
						form.append('file', optimized.blob, optimized.filename);
						form.append('filename', file.name);
						form.append('width', String(optimized.width));
						form.append('height', String(optimized.height));
						selectedTags.forEach((tag) => form.append('tags', tag));
						const payload = await requestJson<{ photo: AdminPhoto }>('/api/admin/photos', { method: 'POST', body: form });
						state.photos.push(payload.photo);
						completed += 1;
					}
					setStatus(uploadStatus, `${completed} photograph${completed === 1 ? '' : 's'} published.`);
					uploadForm.reset();
					fileSelection.textContent = '写真を選択してください';
					renderLibrary();
				} catch (error) {
					setStatus(uploadStatus, error instanceof Error ? error.message : 'アップロードできませんでした。', true);
				} finally {
					submit.disabled = false;
				}
			});

			loginForm.addEventListener('submit', async (event) => {
				event.preventDefault();
				setStatus(loginStatus, 'Logging in…');
				const password = new FormData(loginForm).get('password');
				try {
					await requestJson('/api/admin/login', {
						method: 'POST',
						headers: { 'content-type': 'application/json' },
						body: JSON.stringify({ password }),
					});
					loginForm.reset();
					showWorkspace();
					await loadPhotos();
				} catch (error) {
					setStatus(loginStatus, error instanceof Error ? error.message : 'ログインできませんでした。', true);
				}
			});

			document.querySelector<HTMLElement>('[data-logout]')!.addEventListener('click', async () => {
				try {
					await requestJson('/api/admin/logout', { method: 'POST' });
				} finally {
					showLogin();
				}
			});

			document.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach((button) => {
				button.addEventListener('click', () => {
					state.filter = button.dataset.filter as 'all' | Tag;
					document.querySelectorAll('[data-filter]').forEach((item) => item.classList.toggle('is-active', item === button));
					setStatus(libraryStatus);
					renderLibrary();
				});
			});

			async function initialize() {
				try {
					const session = await requestJson<{ authenticated: boolean; authConfigured: boolean; storageConfigured: boolean }>('/api/admin/session');
					if (!session.authConfigured || !session.storageConfigured) {
						showLogin();
						setStatus(loginStatus, '管理機能の初期設定中です。しばらくしてから再度お試しください。', true);
						return;
					}
					if (!session.authenticated) return showLogin();
					showWorkspace();
					await loadPhotos();
				} catch {
					showLogin();
					setStatus(loginStatus, '管理機能に接続できません。', true);
				}
			}

			initialize();
		</script>
	</body>
</html>
