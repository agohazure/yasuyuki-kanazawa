---
import '../../styles/global.css';
import '../../styles/admin.css';
---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex, nofollow" />
		<meta name="theme-color" content="#f4f4f0" />
		<title>Photo Manager | Yasuyuki Kanazawa</title>
	</head>
	<body class="admin-body">
		<header class="admin-header">
			<a href="/">Yasuyuki Kanazawa</a>
			<span>Photo Manager</span>
		</header>

		<main class="admin-main">
			<section class="admin-login" data-login-panel>
				<div>
					<p class="admin-kicker">Private access</p>
					<h1>Photo Manager</h1>
					<p class="admin-intro">写真を案件・テーマごとのシリーズとして管理できます。</p>
				</div>
				<form class="admin-login__form" data-login-form>
					<label for="admin-password">Password</label>
					<input id="admin-password" name="password" type="password" autocomplete="current-password" required />
					<button type="submit">Log in</button>
					<p class="admin-status" data-login-status aria-live="polite"></p>
				</form>
			</section>

			<section class="admin-workspace" data-workspace hidden>
				<div class="admin-toolbar">
					<div>
						<p class="admin-kicker">Portfolio library</p>
						<h1>Series</h1>
					</div>
					<div class="admin-toolbar__actions">
						<a href="/" target="_blank" rel="noopener noreferrer">View site</a>
						<button type="button" data-logout>Log out</button>
					</div>
				</div>

				<section class="upload-panel" aria-labelledby="upload-title">
					<div>
						<p class="admin-index">01</p>
						<h2 id="upload-title">Upload</h2>
					</div>
					<form class="upload-form" data-upload-form>
						<p class="upload-explanation">選択した写真を、1つの案件・テーマのブロックとして公開します。写真の選択順がシリーズ内の順番になります。</p>

						<label class="admin-field" for="series-target">
							<span>Series / project</span>
							<select id="series-target" name="seriesTarget">
								<option value="new">新しいシリーズを作る</option>
							</select>
						</label>

						<div class="new-series-fields" data-new-series-fields>
							<label class="admin-field" for="series-title">
								<span>案件名・テーマ名</span>
								<input id="series-title" name="seriesTitle" type="text" maxlength="120" placeholder="例：Tokyo Portraits" />
							</label>

							<fieldset class="tag-fieldset" data-upload-tags>
								<legend>Category tags</legend>
								<label><input type="checkbox" name="upload-tag" value="portrait" /> Portrait</label>
								<label><input type="checkbox" name="upload-tag" value="commercial" /> Commercial</label>
								<label><input type="checkbox" name="upload-tag" value="landscape" /> Landscape</label>
								<label><input type="checkbox" name="upload-tag" value="documentary" /> Documentary</label>
							</fieldset>
						</div>
						<p class="upload-selection" data-series-note></p>

						<label class="upload-drop" for="photo-files">
							<span>Select photographs</span>
							<small>JPEG / PNG / WebP / AVIF · 複数選択可</small>
						</label>
						<input id="photo-files" class="visually-hidden" name="files" type="file" accept="image/jpeg,image/png,image/webp,image/avif" multiple required />
						<p class="upload-selection" data-file-selection>写真を選択してください</p>

						<button class="admin-primary" type="submit">Create series &amp; publish</button>
						<p class="admin-status" data-upload-status aria-live="polite"></p>
					</form>
				</section>

				<section class="library-panel" aria-labelledby="library-title">
					<div class="library-heading">
						<div>
							<p class="admin-index">02</p>
							<h2 id="library-title">Library</h2>
						</div>
						<p class="library-count" data-library-count></p>
					</div>

					<div class="library-filters" role="group" aria-label="Filter series">
						<button type="button" class="is-active" data-filter="all">All</button>
						<button type="button" data-filter="portrait">Portrait</button>
						<button type="button" data-filter="commercial">Commercial</button>
						<button type="button" data-filter="landscape">Landscape</button>
						<button type="button" data-filter="documentary">Documentary</button>
					</div>
					<p class="library-help">写真の← →でシリーズ内の順番を変更。カテゴリーを選ぶと、シリーズ自体の掲載順も変更できます。</p>
					<p class="admin-status" data-library-status aria-live="polite"></p>
					<div class="series-library" data-series-library></div>
				</section>
			</section>
		</main>

		<script>
			type Tag = 'portrait' | 'commercial' | 'landscape' | 'documentary';
			type AdminPhoto = {
				id: string;
				seriesId: string;
				sequence: number;
				filename: string;
				title: string;
				alt: string;
				image: string;
				width: number;
				height: number;
				aspect: 'portrait' | 'landscape' | 'square';
				published: boolean;
				createdAt: string;
			};
			type AdminSeries = {
				id: string;
				title: string;
				published: boolean;
				tags: Tag[];
				positions: Partial<Record<Tag, number>>;
				photoIds: string[];
				createdAt: string;
			};
			type AdminPreview = {
				id: string;
				title: string;
				tag: Tag;
				photoCount: number;
			};

			const tags: Tag[] = ['portrait', 'commercial', 'landscape', 'documentary'];
			const tagLabels: Record<Tag, string> = {
				portrait: 'Portrait',
				commercial: 'Commercial',
				landscape: 'Landscape',
				documentary: 'Documentary',
			};
			const state: { photos: AdminPhoto[]; series: AdminSeries[]; previews: AdminPreview[]; filter: 'all' | Tag } = {
				photos: [],
				series: [],
				previews: [],
				filter: 'all',
			};

			const loginPanel = document.querySelector<HTMLElement>('[data-login-panel]')!;
			const workspace = document.querySelector<HTMLElement>('[data-workspace]')!;
			const loginForm = document.querySelector<HTMLFormElement>('[data-login-form]')!;
			const loginStatus = document.querySelector<HTMLElement>('[data-login-status]')!;
			const uploadForm = document.querySelector<HTMLFormElement>('[data-upload-form]')!;
			const seriesTarget = document.querySelector<HTMLSelectElement>('#series-target')!;
			const seriesTitle = document.querySelector<HTMLInputElement>('#series-title')!;
			const newSeriesFields = document.querySelector<HTMLElement>('[data-new-series-fields]')!;
			const uploadTags = document.querySelector<HTMLFieldSetElement>('[data-upload-tags]')!;
			const seriesNote = document.querySelector<HTMLElement>('[data-series-note]')!;
			const fileInput = document.querySelector<HTMLInputElement>('#photo-files')!;
			const fileSelection = document.querySelector<HTMLElement>('[data-file-selection]')!;
			const uploadStatus = document.querySelector<HTMLElement>('[data-upload-status]')!;
			const libraryStatus = document.querySelector<HTMLElement>('[data-library-status]')!;
			const library = document.querySelector<HTMLElement>('[data-series-library]')!;
			const libraryCount = document.querySelector<HTMLElement>('[data-library-count]')!;

			function setStatus(target: HTMLElement, message = '', error = false) {
				target.textContent = message;
				target.classList.toggle('is-error', error);
			}

			async function requestJson<T>(url: string, options: RequestInit = {}) {
				const response = await fetch(url, { ...options, credentials: 'same-origin' });
				const payload = (await response.json().catch(() => ({}))) as T & { error?: string };
				if (!response.ok) throw new Error(payload.error || '処理を完了できませんでした。');
				return payload;
			}

			function showLogin() {
				loginPanel.hidden = false;
				workspace.hidden = true;
			}

			function showWorkspace() {
				loginPanel.hidden = true;
				workspace.hidden = false;
			}

			function element<K extends keyof HTMLElementTagNameMap>(tag: K, className?: string, text?: string) {
				const node = document.createElement(tag);
				if (className) node.className = className;
				if (text !== undefined) node.textContent = text;
				return node;
			}

			function photosForSeries(series: AdminSeries) {
				const byId = new Map(state.photos.map((photo) => [photo.id, photo]));
				return series.photoIds.map((id) => byId.get(id)).filter((photo): photo is AdminPhoto => Boolean(photo));
			}

			function visibleSeries() {
				if (state.filter === 'all') return [...state.series].sort((left, right) => right.createdAt.localeCompare(left.createdAt));
				return state.series
					.filter((item) => item.tags.includes(state.filter as Tag))
					.sort((left, right) => (left.positions[state.filter as Tag] ?? Number.MAX_SAFE_INTEGER) - (right.positions[state.filter as Tag] ?? Number.MAX_SAFE_INTEGER));
			}

			function visiblePreviews() {
				if (state.filter === 'all') return state.previews;
				return state.previews.filter((preview) => preview.tag === state.filter);
			}

			function makeTagCheckbox(series: AdminSeries, tag: Tag) {
				const label = element('label', 'photo-tag');
				const input = document.createElement('input');
				input.type = 'checkbox';
				input.value = tag;
				input.checked = series.tags.includes(tag);
				input.dataset.cardTag = tag;
				label.append(input, document.createTextNode(tagLabels[tag]));
				return label;
			}

			function syncUploadMode() {
				const isNew = seriesTarget.value === 'new';
				newSeriesFields.hidden = !isNew;
				seriesTitle.disabled = !isNew;
				uploadTags.disabled = !isNew;
				const selected = state.series.find((item) => item.id === seriesTarget.value);
				seriesNote.textContent = selected ? `追加先：${selected.title} · ${selected.tags.map((tag) => tagLabels[tag]).join(' / ')}` : '';
				uploadForm.querySelector<HTMLButtonElement>('button[type="submit"]')!.textContent = isNew ? 'Create series & publish' : 'Add photographs';
			}

			function renderSeriesOptions(preferred?: string) {
				const current = preferred || seriesTarget.value;
				const first = document.createElement('option');
				first.value = 'new';
				first.textContent = '新しいシリーズを作る';
				seriesTarget.replaceChildren(first);
				[...state.series]
					.sort((left, right) => right.createdAt.localeCompare(left.createdAt))
					.forEach((item) => {
						const option = document.createElement('option');
						option.value = item.id;
						option.textContent = item.title;
						seriesTarget.append(option);
					});
				seriesTarget.value = state.series.some((item) => item.id === current) ? current : 'new';
				syncUploadMode();
			}

			function renderLibrary() {
				const items = visibleSeries();
				const previews = visiblePreviews();
				library.replaceChildren();
				libraryCount.textContent = `${items.length + previews.length} series`;

				if (items.length === 0 && previews.length === 0) {
					library.append(element('p', 'library-empty', 'まだシリーズがありません。上のUploadから追加してください。'));
					return;
				}

				previews.forEach((preview, previewIndex) => {
					const card = element('article', 'series-card series-card--preview');
					card.dataset.previewTag = preview.tag;
					const media = element('div', 'series-card__media series-card__media--preview');
					for (let index = 0; index < preview.photoCount; index += 1) {
						const item = element('figure', 'series-photo series-photo--preview');
						const visual = element('div', 'series-preview__visual');
						visual.append(element('span', '', String(index + 1).padStart(2, '0')), element('span', '', 'Preview'));
						const caption = document.createElement('figcaption');
						caption.append(element('span', 'series-photo__index', String(index + 1).padStart(2, '0')));
						item.append(visual, caption);
						media.append(item);
					}

					const body = element('div', 'series-card__body');
					const heading = element('div', 'series-card__heading');
					heading.append(
						element('p', 'series-card__number', String(previewIndex + 1).padStart(2, '0')),
						element('p', 'series-card__count', `${preview.photoCount} placeholder photographs`),
					);
					body.append(heading, element('p', 'series-preview__title', preview.title));
					const tag = element('p', 'series-preview__tag', tagLabels[preview.tag]);
					const note = element('p', 'series-preview__note', '実写真が未投稿のときだけ表示される仮シリーズです。削除後は復元されません。');
					const actions = element('div', 'photo-card__actions');
					const remove = element('button', 'photo-delete', 'Delete preview');
					remove.type = 'button';
					remove.addEventListener('click', () => deletePreview(preview));
					actions.append(remove);
					body.append(tag, note, actions);
					card.append(media, body);
					library.append(card);
				});

				items.forEach((series, seriesIndex) => {
					const card = element('article', 'series-card');
					card.dataset.seriesId = series.id;

					const media = element('div', 'series-card__media');
					const photos = photosForSeries(series);
					if (photos.length === 0) media.append(element('p', 'series-card__empty', 'No photographs'));
					photos.forEach((photo, photoIndex) => {
						const item = element('figure', 'series-photo');
						const image = document.createElement('img');
						image.src = photo.image;
						image.alt = photo.alt;
						image.loading = 'lazy';
						const caption = element('figcaption');
						caption.append(element('span', 'series-photo__index', String(photoIndex + 1).padStart(2, '0')));
						const controls = element('span', 'series-photo__controls');
						if (state.series.length > 1) {
							const moveTarget = document.createElement('select');
							moveTarget.className = 'series-photo__move';
							moveTarget.setAttribute('aria-label', 'Move photograph to another series');
							moveTarget.title = 'Move to another series';
							state.series.forEach((item) => {
								const option = document.createElement('option');
								option.value = item.id;
								option.textContent = item.id === series.id ? 'Move…' : item.title;
								option.selected = item.id === series.id;
								moveTarget.append(option);
							});
							moveTarget.addEventListener('change', () => movePhotoToSeries(photo, moveTarget.value));
							controls.append(moveTarget);
						}
						if (photos.length > 1) {
							const earlier = element('button', '', '←');
							earlier.type = 'button';
							earlier.title = 'Move earlier in series';
							earlier.disabled = photoIndex === 0;
							earlier.addEventListener('click', () => movePhoto(series, photo.id, -1));
							const later = element('button', '', '→');
							later.type = 'button';
							later.title = 'Move later in series';
							later.disabled = photoIndex === photos.length - 1;
							controls.append(earlier, later);
						}
						const remove = element('button', 'series-photo__delete', 'Delete');
						remove.type = 'button';
						remove.addEventListener('click', () => deletePhoto(series, photo));
						controls.append(remove);
						caption.append(controls);
						item.append(image, caption);
						media.append(item);
					});

					const body = element('div', 'series-card__body');
					const heading = element('div', 'series-card__heading');
					heading.append(element('p', 'series-card__number', String(seriesIndex + previews.length + 1).padStart(2, '0')), element('p', 'series-card__count', `${photos.length} photograph${photos.length === 1 ? '' : 's'}`));
					body.append(heading);

					const titleLabel = element('label', 'admin-field');
					titleLabel.append(element('span', '', '案件名・テーマ名'));
					const titleInput = document.createElement('input');
					titleInput.type = 'text';
					titleInput.value = series.title;
					titleInput.maxLength = 120;
					titleInput.dataset.field = 'title';
					titleLabel.append(titleInput);
					body.append(titleLabel);

					const tagGroup = element('fieldset', 'photo-card__tags');
					const legend = document.createElement('legend');
					legend.textContent = 'Category tags';
					tagGroup.append(legend, ...tags.map((tag) => makeTagCheckbox(series, tag)));
					body.append(tagGroup);

					const visibility = element('label', 'photo-visibility');
					const published = document.createElement('input');
					published.type = 'checkbox';
					published.checked = series.published;
					published.dataset.field = 'published';
					visibility.append(published, document.createTextNode(' Published'));
					body.append(visibility);

					const actions = element('div', 'photo-card__actions');
					if (state.filter !== 'all') {
						const previous = element('button', 'photo-order', '↑');
						previous.type = 'button';
						previous.title = 'Move series earlier';
						previous.disabled = seriesIndex === 0;
						previous.addEventListener('click', () => moveSeries(series.id, -1));
						const next = element('button', 'photo-order', '↓');
						next.type = 'button';
						next.title = 'Move series later';
						next.disabled = seriesIndex === items.length - 1;
						next.addEventListener('click', () => moveSeries(series.id, 1));
						actions.append(previous, next);
					}

					const save = element('button', 'photo-save', 'Save');
					save.type = 'button';
					save.addEventListener('click', () => saveSeries(card, series));
					const remove = element('button', 'photo-delete', 'Delete series');
					remove.type = 'button';
					remove.addEventListener('click', () => deleteSeries(series));
					actions.append(save, remove);
					body.append(actions);
					card.append(media, body);
					library.append(card);
				});
			}

			async function loadLibrary() {
				const payload = await requestJson<{ photos: AdminPhoto[]; series: AdminSeries[]; previews: AdminPreview[] }>('/api/admin/photos');
				state.photos = payload.photos;
				state.series = payload.series;
				state.previews = payload.previews;
				renderSeriesOptions();
				renderLibrary();
			}

			async function deletePreview(preview: AdminPreview) {
				if (!window.confirm(`「${preview.title}」を削除しますか？`)) return;
				setStatus(libraryStatus, 'Deleting preview…');
				try {
					await requestJson(`/api/admin/previews/${preview.tag}`, { method: 'DELETE' });
					state.previews = state.previews.filter((item) => item.tag !== preview.tag);
					setStatus(libraryStatus, 'Preview deleted. The public site has been updated.');
					renderLibrary();
				} catch (error) {
					setStatus(libraryStatus, error instanceof Error ? error.message : '仮シリーズを削除できませんでした。', true);
				}
			}

			async function saveSeries(card: HTMLElement, series: AdminSeries) {
				setStatus(libraryStatus, 'Saving…');
				const title = card.querySelector<HTMLInputElement>('[data-field="title"]')!.value;
				const published = card.querySelector<HTMLInputElement>('[data-field="published"]')!.checked;
				const selectedTags = [...card.querySelectorAll<HTMLInputElement>('[data-card-tag]:checked')].map((input) => input.value as Tag);
				try {
					const payload = await requestJson<{ series: AdminSeries }>(`/api/admin/series/${series.id}`, {
						method: 'PATCH',
						headers: { 'content-type': 'application/json' },
						body: JSON.stringify({ title, published, tags: selectedTags }),
					});
					state.series = state.series.map((item) => (item.id === series.id ? payload.series : item));
					setStatus(libraryStatus, 'Saved. The public site has been updated.');
					renderSeriesOptions(seriesTarget.value);
					renderLibrary();
				} catch (error) {
					setStatus(libraryStatus, error instanceof Error ? error.message : '保存できませんでした。', true);
				}
			}

			async function deleteSeries(series: AdminSeries) {
				if (!window.confirm(`「${series.title}」と中の写真をすべて削除しますか？`)) return;
				setStatus(libraryStatus, 'Deleting series…');
				try {
					await requestJson(`/api/admin/series/${series.id}`, { method: 'DELETE' });
					state.series = state.series.filter((item) => item.id !== series.id);
					state.photos = state.photos.filter((photo) => photo.seriesId !== series.id);
					setStatus(libraryStatus, 'Series deleted.');
					renderSeriesOptions();
					renderLibrary();
				} catch (error) {
					setStatus(libraryStatus, error instanceof Error ? error.message : '削除できませんでした。', true);
				}
			}

			async function deletePhoto(series: AdminSeries, photo: AdminPhoto) {
				if (!window.confirm('この写真をシリーズから完全に削除しますか？')) return;
				setStatus(libraryStatus, 'Deleting photograph…');
				try {
					await requestJson(`/api/admin/photos/${photo.id}`, { method: 'DELETE' });
					state.photos = state.photos.filter((item) => item.id !== photo.id);
					series.photoIds = series.photoIds.filter((id) => id !== photo.id);
					setStatus(libraryStatus, 'Photograph deleted.');
					renderLibrary();
				} catch (error) {
					setStatus(libraryStatus, error instanceof Error ? error.message : '削除できませんでした。', true);
				}
			}

			async function moveSeries(id: string, direction: -1 | 1) {
				if (state.filter === 'all') return;
				const ordered = visibleSeries();
				const currentIndex = ordered.findIndex((item) => item.id === id);
				const destination = currentIndex + direction;
				if (currentIndex < 0 || destination < 0 || destination >= ordered.length) return;
				[ordered[currentIndex], ordered[destination]] = [ordered[destination], ordered[currentIndex]];
				setStatus(libraryStatus, 'Reordering series…');
				try {
					await requestJson('/api/admin/order', {
						method: 'POST',
						headers: { 'content-type': 'application/json' },
						body: JSON.stringify({ tag: state.filter, ids: ordered.map((item) => item.id) }),
					});
					ordered.forEach((item, index) => (item.positions[state.filter as Tag] = index));
					setStatus(libraryStatus, 'Series order updated.');
					renderLibrary();
				} catch (error) {
					setStatus(libraryStatus, error instanceof Error ? error.message : '順番を変更できませんでした。', true);
				}
			}

			async function movePhoto(series: AdminSeries, id: string, direction: -1 | 1) {
				const currentIndex = series.photoIds.indexOf(id);
				const destination = currentIndex + direction;
				if (currentIndex < 0 || destination < 0 || destination >= series.photoIds.length) return;
				const nextIds = [...series.photoIds];
				[nextIds[currentIndex], nextIds[destination]] = [nextIds[destination], nextIds[currentIndex]];
				setStatus(libraryStatus, 'Reordering photographs…');
				try {
					const payload = await requestJson<{ series: AdminSeries }>(`/api/admin/series/${series.id}`, {
						method: 'PATCH',
						headers: { 'content-type': 'application/json' },
						body: JSON.stringify({ photoIds: nextIds }),
					});
					state.series = state.series.map((item) => (item.id === series.id ? payload.series : item));
					setStatus(libraryStatus, 'Photograph order updated.');
					renderLibrary();
				} catch (error) {
					setStatus(libraryStatus, error instanceof Error ? error.message : '順番を変更できませんでした。', true);
				}
			}

			async function movePhotoToSeries(photo: AdminPhoto, destinationId: string) {
				if (!destinationId || destinationId === photo.seriesId) return;
				setStatus(libraryStatus, 'Moving photograph…');
				try {
					await requestJson(`/api/admin/photos/${photo.id}`, {
						method: 'PATCH',
						headers: { 'content-type': 'application/json' },
						body: JSON.stringify({ seriesId: destinationId }),
					});
					await loadLibrary();
					setStatus(libraryStatus, 'Photograph moved to another series.');
				} catch (error) {
					setStatus(libraryStatus, error instanceof Error ? error.message : '写真を移動できませんでした。', true);
					renderLibrary();
				}
			}

			async function decodeImage(file: File) {
				const url = URL.createObjectURL(file);
				try {
					const image = new Image();
					image.src = url;
					if ('decode' in image) await image.decode();
					else await new Promise<void>((resolve, reject) => {
						image.onload = () => resolve();
						image.onerror = () => reject(new Error('画像を読み込めませんでした。'));
					});
					return image;
				} catch (error) {
					URL.revokeObjectURL(url);
					throw error;
				}
			}

			async function optimizeImage(file: File) {
				const image = await decodeImage(file);
				const sourceUrl = image.src;
				try {
					const longestSide = Math.max(image.naturalWidth, image.naturalHeight);
					const scale = Math.min(1, 3200 / longestSide);
					const width = Math.max(1, Math.round(image.naturalWidth * scale));
					const height = Math.max(1, Math.round(image.naturalHeight * scale));
					const canvas = document.createElement('canvas');
					canvas.width = width;
					canvas.height = height;
					const context = canvas.getContext('2d');
					if (!context) throw new Error('画像を処理できませんでした。');
					context.drawImage(image, 0, 0, width, height);
					const blob = await new Promise<Blob>((resolve, reject) => {
						canvas.toBlob((result) => (result ? resolve(result) : reject(new Error('画像を変換できませんでした。'))), 'image/webp', 0.9);
					});
					return { blob, width, height, filename: file.name.replace(/\.[^.]+$/, '') + '.webp' };
				} finally {
					URL.revokeObjectURL(sourceUrl);
				}
			}

			fileInput.addEventListener('change', () => {
				const count = fileInput.files?.length ?? 0;
				fileSelection.textContent = count ? `${count} photograph${count === 1 ? '' : 's'} selected` : '写真を選択してください';
			});

			seriesTarget.addEventListener('change', syncUploadMode);

			uploadForm.addEventListener('submit', async (event) => {
				event.preventDefault();
				const files = [...(fileInput.files ?? [])];
				if (files.length === 0) return setStatus(uploadStatus, '写真を選択してください。', true);

				const isNew = seriesTarget.value === 'new';
				const selectedTags = [...uploadForm.querySelectorAll<HTMLInputElement>('[name="upload-tag"]:checked')].map((input) => input.value as Tag);
				if (isNew && !seriesTitle.value.trim()) return setStatus(uploadStatus, '案件名・テーマ名を入力してください。', true);
				if (isNew && selectedTags.length === 0) return setStatus(uploadStatus, 'カテゴリーを1つ以上選択してください。', true);

				const submit = uploadForm.querySelector<HTMLButtonElement>('button[type="submit"]')!;
				submit.disabled = true;
				let completed = 0;
				let targetSeries = state.series.find((item) => item.id === seriesTarget.value);
				let createdSeriesId = '';
				try {
					if (isNew) {
						const payload = await requestJson<{ series: AdminSeries }>('/api/admin/series', {
							method: 'POST',
							headers: { 'content-type': 'application/json' },
							body: JSON.stringify({ title: seriesTitle.value, tags: selectedTags }),
						});
						targetSeries = payload.series;
						createdSeriesId = payload.series.id;
						state.series.push(payload.series);
					}
					if (!targetSeries) throw new Error('追加先のシリーズを選択してください。');

					for (const file of files) {
						setStatus(uploadStatus, `${completed + 1} / ${files.length} — optimizing ${file.name}`);
						const optimized = await optimizeImage(file);
						const form = new FormData();
						form.append('file', optimized.blob, optimized.filename);
						form.append('filename', file.name);
						form.append('width', String(optimized.width));
						form.append('height', String(optimized.height));
						form.append('seriesId', targetSeries.id);
						const payload = await requestJson<{ photo: AdminPhoto; series: AdminSeries }>('/api/admin/photos', { method: 'POST', body: form });
						state.photos.push(payload.photo);
						state.series = state.series.map((item) => (item.id === payload.series.id ? payload.series : item));
						targetSeries = payload.series;
						completed += 1;
					}

					setStatus(uploadStatus, `${targetSeries.title} — ${completed} photograph${completed === 1 ? '' : 's'} published.`);
					uploadForm.reset();
					fileSelection.textContent = '写真を選択してください';
					renderSeriesOptions(targetSeries.id);
					renderLibrary();
				} catch (error) {
					if (createdSeriesId && completed === 0) {
						await requestJson(`/api/admin/series/${createdSeriesId}`, { method: 'DELETE' }).catch(() => undefined);
						state.series = state.series.filter((item) => item.id !== createdSeriesId);
					}
					setStatus(uploadStatus, error instanceof Error ? error.message : 'アップロードできませんでした。', true);
					renderSeriesOptions();
					renderLibrary();
				} finally {
					submit.disabled = false;
				}
			});

			loginForm.addEventListener('submit', async (event) => {
				event.preventDefault();
				setStatus(loginStatus, 'Logging in…');
				const password = new FormData(loginForm).get('password');
				try {
					await requestJson('/api/admin/login', {
						method: 'POST',
						headers: { 'content-type': 'application/json' },
						body: JSON.stringify({ password }),
					});
					loginForm.reset();
					showWorkspace();
					await loadLibrary();
				} catch (error) {
					setStatus(loginStatus, error instanceof Error ? error.message : 'ログインできませんでした。', true);
				}
			});

			document.querySelector<HTMLElement>('[data-logout]')!.addEventListener('click', async () => {
				try {
					await requestJson('/api/admin/logout', { method: 'POST' });
				} finally {
					showLogin();
				}
			});

			document.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach((button) => {
				button.addEventListener('click', () => {
					state.filter = button.dataset.filter as 'all' | Tag;
					document.querySelectorAll('[data-filter]').forEach((item) => item.classList.toggle('is-active', item === button));
					setStatus(libraryStatus);
					renderLibrary();
				});
			});

			async function initialize() {
				try {
					const session = await requestJson<{ authenticated: boolean; authConfigured: boolean; storageConfigured: boolean }>('/api/admin/session');
					if (!session.authConfigured || !session.storageConfigured) {
						showLogin();
						setStatus(loginStatus, '管理機能の初期設定中です。しばらくしてから再度お試しください。', true);
						return;
					}
					if (!session.authenticated) return showLogin();
					showWorkspace();
					await loadLibrary();
				} catch {
					showLogin();
					setStatus(loginStatus, '管理機能に接続できません。', true);
				}
			}

			initialize();
		</script>
	</body>
</html>
