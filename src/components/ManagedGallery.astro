<script>
	type Tag = 'portrait' | 'commercial' | 'landscape' | 'documentary';
	type ManagedPhoto = {
		id: string;
		title: string;
		alt: string;
		image: string;
		width: number;
		height: number;
		aspect: 'portrait' | 'landscape' | 'square';
		tags: Tag[];
		positions: Partial<Record<Tag, number>>;
	};

	const tagOrder: Tag[] = ['portrait', 'commercial', 'landscape', 'documentary'];

	function orderedPhotos(photos: ManagedPhoto[], tag: Tag) {
		return photos
			.filter((photo) => photo.tags.includes(tag))
			.sort((left, right) => (left.positions[tag] ?? Number.MAX_SAFE_INTEGER) - (right.positions[tag] ?? Number.MAX_SAFE_INTEGER));
	}

	function makeFigure(photo: ManagedPhoto, priority: boolean) {
		const figure = document.createElement('figure');
		figure.className = `work-figure work-figure--managed work-figure--${photo.aspect}`;

		const image = document.createElement('img');
		image.className = 'work-figure__image';
		image.src = photo.image;
		image.alt = photo.alt;
		image.width = photo.width;
		image.height = photo.height;
		image.loading = priority ? 'eager' : 'lazy';
		image.decoding = 'async';
		if (priority) image.setAttribute('fetchpriority', 'high');
		figure.append(image);

		if (photo.title) {
			const caption = document.createElement('figcaption');
			caption.textContent = photo.title;
			figure.append(caption);
		}

		return figure;
	}

	async function hydrateManagedGalleries() {
		const galleries = document.querySelectorAll<HTMLElement>('[data-managed-gallery]');
		if (galleries.length === 0) return;

		try {
			const response = await fetch('/api/works', { cache: 'no-store' });
			if (!response.ok) return;
			const payload = (await response.json()) as { photos?: ManagedPhoto[] };
			const photos = Array.isArray(payload.photos) ? payload.photos : [];
			if (photos.length === 0) return;

			for (const gallery of galleries) {
				const mode = gallery.dataset.managedGallery;
				if (mode === 'featured') {
					tagOrder.forEach((tag, index) => {
						const photo = orderedPhotos(photos, tag)[0];
						const current = gallery.children[index];
						if (photo && current) current.replaceWith(makeFigure(photo, index === 0));
					});
					continue;
				}

				if (!tagOrder.includes(mode as Tag)) continue;
				const selected = orderedPhotos(photos, mode as Tag);
				if (selected.length > 0) gallery.replaceChildren(...selected.map((photo, index) => makeFigure(photo, index === 0)));
			}
		} catch {
			// Static placeholders remain visible if the media service is unavailable.
		}
	}

	hydrateManagedGalleries();
</script>
