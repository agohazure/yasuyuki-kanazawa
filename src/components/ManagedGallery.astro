<script>
	type Tag = 'portrait' | 'commercial' | 'landscape' | 'documentary';
	type ManagedPhoto = {
		id: string;
		title: string;
		alt: string;
		image: string;
		width: number;
		height: number;
		aspect: 'portrait' | 'landscape' | 'square';
	};
	type ManagedSeries = {
		id: string;
		title: string;
		tags: Tag[];
		positions: Partial<Record<Tag, number>>;
		photos: ManagedPhoto[];
	};

	const tagOrder: Tag[] = ['portrait', 'commercial', 'landscape', 'documentary'];

	function orderedSeries(series: ManagedSeries[], tag: Tag) {
		return series
			.filter((item) => item.tags.includes(tag) && item.photos.length > 0)
			.sort((left, right) => (left.positions[tag] ?? Number.MAX_SAFE_INTEGER) - (right.positions[tag] ?? Number.MAX_SAFE_INTEGER));
	}

	function connectSwipeTrack(track: HTMLElement, slides: HTMLElement[], counter?: HTMLElement) {
		let current = 0;
		let scrollFrame = 0;

		const updateCounter = () => {
			if (counter) counter.textContent = `${String(current + 1).padStart(2, '0')} / ${String(slides.length).padStart(2, '0')}`;
		};

		const nearestSlide = () => {
			const center = track.scrollLeft + track.clientWidth / 2;
			let nearest = 0;
			let distance = Number.POSITIVE_INFINITY;
			slides.forEach((slide, index) => {
				const nextDistance = Math.abs(slide.offsetLeft + slide.offsetWidth / 2 - center);
				if (nextDistance < distance) {
					distance = nextDistance;
					nearest = index;
				}
			});
			return nearest;
		};

		const scrollToSlide = (index: number, behavior: ScrollBehavior = 'smooth') => {
			current = Math.max(0, Math.min(index, slides.length - 1));
			const slide = slides[current];
			track.scrollTo({
				left: slide.offsetLeft - (track.clientWidth - slide.offsetWidth) / 2,
				behavior,
			});
			updateCounter();
		};

		track.addEventListener('scroll', () => {
			cancelAnimationFrame(scrollFrame);
			scrollFrame = requestAnimationFrame(() => {
				current = nearestSlide();
				updateCounter();
			});
		}, { passive: true });

		track.addEventListener('keydown', (event) => {
			if (event.key === 'ArrowLeft') {
				event.preventDefault();
				scrollToSlide(current - 1);
			}
			if (event.key === 'ArrowRight') {
				event.preventDefault();
				scrollToSlide(current + 1);
			}
		});

		if (slides.length > 1) {
			let dragStartX = 0;
			let dragStartScroll = 0;

			track.addEventListener('pointerdown', (event) => {
				if (event.pointerType !== 'mouse' || event.button !== 0) return;
				dragStartX = event.clientX;
				dragStartScroll = track.scrollLeft;
				track.classList.add('is-dragging');
				track.setPointerCapture(event.pointerId);
			});

			track.addEventListener('pointermove', (event) => {
				if (!track.classList.contains('is-dragging')) return;
				track.scrollLeft = dragStartScroll - (event.clientX - dragStartX);
			});

			const finishDrag = (event: PointerEvent) => {
				if (!track.classList.contains('is-dragging')) return;
				track.classList.remove('is-dragging');
				if (track.hasPointerCapture(event.pointerId)) track.releasePointerCapture(event.pointerId);
				scrollToSlide(nearestSlide());
			};
			track.addEventListener('pointerup', finishDrag);
			track.addEventListener('pointercancel', finishDrag);
		}

		let previousSignature = '';
		const fitTrackEnds = () => {
			const host = (track.parentElement ?? track) as HTMLElement;
			const rect = host.getBoundingClientRect();
			const width = rect.width;
			if (width === 0) return;
			const signature = `${Math.round(width)}x${Math.round(rect.height)}`;
			if (signature === previousSignature) return;
			previousSignature = signature;
			if (slides.length > 1) {
				track.style.paddingLeft = `${Math.max(0, (width - slides[0].getBoundingClientRect().width) / 2)}px`;
				track.style.paddingRight = `${Math.max(0, (width - slides.at(-1)!.getBoundingClientRect().width) / 2)}px`;
			} else {
				track.style.paddingInline = '0px';
			}
			requestAnimationFrame(() => scrollToSlide(current, 'auto'));
		};

		requestAnimationFrame(fitTrackEnds);
		new ResizeObserver(fitTrackEnds).observe(track);
		updateCounter();
	}

	function makePreviewSeries(gallery: HTMLElement, tag: Tag) {
		const figures = [...gallery.querySelectorAll<HTMLElement>(':scope > .work-figure')];
		const slides = figures
			.map((figure) => figure.querySelector<HTMLElement>('.work-figure__placeholder')?.cloneNode(true) as HTMLElement | undefined)
			.filter((slide): slide is HTMLElement => Boolean(slide));
		if (slides.length < 2) return;
		const firstFigure = figures[0];
		const aspect = firstFigure.classList.contains('work-figure--portrait')
			? 'portrait'
			: firstFigure.classList.contains('work-figure--square')
				? 'square'
				: 'landscape';
		const ratio = aspect === 'portrait' ? '4 / 5' : aspect === 'square' ? '1' : '3 / 2';
		const label = `${tag[0].toUpperCase()}${tag.slice(1)}`;

		const figure = document.createElement('figure');
		figure.className = `work-series work-series--${aspect} work-series--fallback`;

		const stage = document.createElement('div');
		stage.className = 'work-series__stage';
		stage.style.aspectRatio = ratio;
		stage.tabIndex = 0;
		stage.setAttribute('role', 'group');
		stage.setAttribute('aria-label', `${label}, ${slides.length} photograph preview`);

		const track = document.createElement('div');
		track.className = 'work-series__track';
		track.tabIndex = 0;
		const swipeSlides = slides.map((content) => {
			const slide = document.createElement('div');
			slide.className = 'work-series__slide work-series__slide--fallback';
			slide.style.aspectRatio = ratio;
			slide.append(content);
			return slide;
		});
		track.append(...swipeSlides);
		stage.append(track);

		const counter = document.createElement('span');
		counter.className = 'work-series__counter';

		const meta = document.createElement('figcaption');
		meta.className = 'work-series__meta';
		const title = document.createElement('span');
		title.textContent = `${label} Preview series`;
		meta.append(title, counter);
		figure.append(stage, meta);
		connectSwipeTrack(track, swipeSlides, counter);
		gallery.replaceChildren(figure);
	}

	function makeSeriesBlock(series: ManagedSeries, priority: boolean, featured = false) {
		const cover = series.photos[0];
		const figure = document.createElement('figure');
		figure.className = `work-series work-series--${cover.aspect}${featured ? ' work-series--featured' : ''}`;
		figure.dataset.seriesId = series.id;

		const stage = document.createElement('div');
		stage.className = 'work-series__stage';
		stage.setAttribute('role', 'group');
		stage.setAttribute('aria-label', `${series.title}, ${series.photos.length} photographs`);

		const track = document.createElement('div');
		track.className = `work-series__track${series.photos.length === 1 ? ' work-series__track--single' : ''}`;
		track.tabIndex = 0;
		track.setAttribute('aria-label', `Swipe through ${series.title}`);
		const slides = series.photos.map((photo, index) => {
			const slide = document.createElement('div');
			slide.className = 'work-series__slide';
			slide.style.aspectRatio = `${photo.width} / ${photo.height}`;

			const image = document.createElement('img');
			image.className = 'work-series__image';
			image.src = photo.image;
			image.alt = photo.alt;
			image.width = photo.width;
			image.height = photo.height;
			image.loading = priority && index === 0 ? 'eager' : 'lazy';
			image.decoding = 'async';
			image.draggable = false;
			if (priority && index === 0) image.setAttribute('fetchpriority', 'high');
			slide.append(image);
			return slide;
		});
		track.append(...slides);
		stage.append(track);

		const counter = document.createElement('span');
		counter.className = 'work-series__counter';

		const meta = document.createElement('figcaption');
		meta.className = 'work-series__meta';
		const title = document.createElement('span');
		title.textContent = series.title;
		meta.append(title);
		if (series.photos.length > 1) meta.append(counter);
		figure.append(stage, meta);
		connectSwipeTrack(track, slides, series.photos.length > 1 ? counter : undefined);
		return figure;
	}

	async function hydrateManagedGalleries() {
		const galleries = document.querySelectorAll<HTMLElement>('[data-managed-gallery]');
		if (galleries.length === 0) return;

		try {
			const response = await fetch('/api/works', { cache: 'no-store' });
			if (!response.ok) return;
			const payload = (await response.json()) as { series?: ManagedSeries[]; hiddenFallbacks?: Tag[] };
			const series = Array.isArray(payload.series) ? payload.series : [];
			const hiddenFallbacks = Array.isArray(payload.hiddenFallbacks) ? payload.hiddenFallbacks : [];

			for (const gallery of galleries) {
				const mode = gallery.dataset.managedGallery;
				if (mode === 'featured') {
					const fallbackFigures = [...gallery.children];
					tagOrder.forEach((tag, index) => {
						const item = orderedSeries(series, tag)[0];
						const current = fallbackFigures[index];
						if (item && current) current.replaceWith(makeSeriesBlock(item, index === 0, true));
						else if (hiddenFallbacks.includes(tag)) current?.remove();
					});
					continue;
				}

				if (!tagOrder.includes(mode as Tag)) continue;
				const selected = orderedSeries(series, mode as Tag);
				if (selected.length > 0) gallery.replaceChildren(...selected.map((item, index) => makeSeriesBlock(item, index === 0)));
				else if (hiddenFallbacks.includes(mode as Tag)) gallery.replaceChildren();
				else makePreviewSeries(gallery, mode as Tag);
			}
		} catch {
			for (const gallery of galleries) {
				const mode = gallery.dataset.managedGallery;
				if (tagOrder.includes(mode as Tag)) makePreviewSeries(gallery, mode as Tag);
			}
		}
	}

	hydrateManagedGalleries();
</script>
