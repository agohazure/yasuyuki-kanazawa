<script>
	type Tag = 'portrait' | 'commercial' | 'landscape' | 'documentary';
	type ManagedPhoto = {
		id: string;
		title: string;
		alt: string;
		image: string;
		width: number;
		height: number;
		aspect: 'portrait' | 'landscape' | 'square';
	};
	type ManagedSeries = {
		id: string;
		title: string;
		tags: Tag[];
		positions: Partial<Record<Tag, number>>;
		photos: ManagedPhoto[];
	};

	const tagOrder: Tag[] = ['portrait', 'commercial', 'landscape', 'documentary'];

	function orderedSeries(series: ManagedSeries[], tag: Tag) {
		return series
			.filter((item) => item.tags.includes(tag) && item.photos.length > 0)
			.sort((left, right) => (left.positions[tag] ?? Number.MAX_SAFE_INTEGER) - (right.positions[tag] ?? Number.MAX_SAFE_INTEGER));
	}

	function makePreviewSeries(gallery: HTMLElement, tag: Tag) {
		const figures = [...gallery.querySelectorAll<HTMLElement>(':scope > .work-figure')];
		const slides = figures
			.map((figure) => figure.querySelector<HTMLElement>('.work-figure__placeholder')?.cloneNode(true) as HTMLElement | undefined)
			.filter((slide): slide is HTMLElement => Boolean(slide));
		if (slides.length < 2) return;
		const firstFigure = figures[0];
		const aspect = firstFigure.classList.contains('work-figure--portrait')
			? 'portrait'
			: firstFigure.classList.contains('work-figure--square')
				? 'square'
				: 'landscape';
		const ratio = aspect === 'portrait' ? '4 / 5' : aspect === 'square' ? '1' : '3 / 2';
		const label = `${tag[0].toUpperCase()}${tag.slice(1)}`;

		const figure = document.createElement('figure');
		figure.className = `work-series work-series--${aspect} work-series--fallback`;

		const stage = document.createElement('div');
		stage.className = 'work-series__stage';
		stage.style.aspectRatio = ratio;
		stage.tabIndex = 0;
		stage.setAttribute('role', 'group');
		stage.setAttribute('aria-label', `${label}, ${slides.length} photograph preview`);

		const frame = document.createElement('div');
		frame.className = 'work-series__fallback-frame';
		stage.append(frame);

		let current = 0;
		const counter = document.createElement('span');
		counter.className = 'work-series__counter';
		const show = (next: number) => {
			current = (next + slides.length) % slides.length;
			frame.classList.remove('is-changing');
			void frame.offsetWidth;
			frame.replaceChildren(slides[current].cloneNode(true));
			frame.classList.add('is-changing');
			counter.textContent = `${String(current + 1).padStart(2, '0')} / ${String(slides.length).padStart(2, '0')}`;
		};

		const previous = document.createElement('button');
		previous.className = 'work-series__edge work-series__edge--previous';
		previous.type = 'button';
		previous.setAttribute('aria-label', `Previous ${label.toLowerCase()} photograph`);
		previous.textContent = '←';
		previous.addEventListener('click', () => show(current - 1));

		const next = document.createElement('button');
		next.className = 'work-series__edge work-series__edge--next';
		next.type = 'button';
		next.setAttribute('aria-label', `Next ${label.toLowerCase()} photograph`);
		next.textContent = '→';
		next.addEventListener('click', () => show(current + 1));
		stage.addEventListener('keydown', (event) => {
			if (event.key === 'ArrowLeft') {
				event.preventDefault();
				show(current - 1);
			}
			if (event.key === 'ArrowRight') {
				event.preventDefault();
				show(current + 1);
			}
		});
		stage.append(previous, next);

		const meta = document.createElement('figcaption');
		meta.className = 'work-series__meta';
		const title = document.createElement('span');
		title.textContent = `${label} Preview series`;
		meta.append(title, counter);
		figure.append(stage, meta);
		show(0);
		gallery.replaceChildren(figure);
	}

	function makeSeriesBlock(series: ManagedSeries, priority: boolean, featured = false) {
		const cover = series.photos[0];
		const figure = document.createElement('figure');
		figure.className = `work-series work-series--${cover.aspect}${featured ? ' work-series--featured' : ''}`;
		figure.dataset.seriesId = series.id;

		const stage = document.createElement('div');
		stage.className = 'work-series__stage';
		stage.tabIndex = 0;
		stage.setAttribute('role', 'group');
		stage.setAttribute('aria-label', `${series.title}, ${series.photos.length} photographs`);
		if (!featured) stage.style.aspectRatio = `${cover.width} / ${cover.height}`;

		const image = document.createElement('img');
		image.className = 'work-series__image';
		image.src = cover.image;
		image.alt = cover.alt;
		image.width = cover.width;
		image.height = cover.height;
		image.loading = priority ? 'eager' : 'lazy';
		image.decoding = 'async';
		if (priority) image.setAttribute('fetchpriority', 'high');
		stage.append(image);

		let current = 0;
		const counter = document.createElement('span');
		counter.className = 'work-series__counter';

		const show = (next: number) => {
			current = (next + series.photos.length) % series.photos.length;
			const photo = series.photos[current];
			image.classList.remove('is-changing');
			void image.offsetWidth;
			image.src = photo.image;
			image.alt = photo.alt;
			image.width = photo.width;
			image.height = photo.height;
			image.classList.add('is-changing');
			counter.textContent = `${String(current + 1).padStart(2, '0')} / ${String(series.photos.length).padStart(2, '0')}`;
			const upcoming = series.photos[(current + 1) % series.photos.length];
			if (upcoming && upcoming.id !== photo.id) new Image().src = upcoming.image;
		};

		if (series.photos.length > 1) {
			const previous = document.createElement('button');
			previous.className = 'work-series__edge work-series__edge--previous';
			previous.type = 'button';
			previous.setAttribute('aria-label', `Previous photograph in ${series.title}`);
			previous.textContent = '←';
			previous.addEventListener('click', () => show(current - 1));

			const next = document.createElement('button');
			next.className = 'work-series__edge work-series__edge--next';
			next.type = 'button';
			next.setAttribute('aria-label', `Next photograph in ${series.title}`);
			next.textContent = '→';
			next.addEventListener('click', () => show(current + 1));
			stage.addEventListener('keydown', (event) => {
				if (event.key === 'ArrowLeft') {
					event.preventDefault();
					show(current - 1);
				}
				if (event.key === 'ArrowRight') {
					event.preventDefault();
					show(current + 1);
				}
			});
			stage.append(previous, next);
		}

		const meta = document.createElement('figcaption');
		meta.className = 'work-series__meta';
		const title = document.createElement('span');
		title.textContent = series.title;
		meta.append(title);
		if (series.photos.length > 1) meta.append(counter);
		figure.append(stage, meta);
		show(0);
		return figure;
	}

	async function hydrateManagedGalleries() {
		const galleries = document.querySelectorAll<HTMLElement>('[data-managed-gallery]');
		if (galleries.length === 0) return;

		try {
			const response = await fetch('/api/works', { cache: 'no-store' });
			if (!response.ok) return;
			const payload = (await response.json()) as { series?: ManagedSeries[]; hiddenFallbacks?: Tag[] };
			const series = Array.isArray(payload.series) ? payload.series : [];
			const hiddenFallbacks = Array.isArray(payload.hiddenFallbacks) ? payload.hiddenFallbacks : [];

			for (const gallery of galleries) {
				const mode = gallery.dataset.managedGallery;
				if (mode === 'featured') {
					const fallbackFigures = [...gallery.children];
					tagOrder.forEach((tag, index) => {
						const item = orderedSeries(series, tag)[0];
						const current = fallbackFigures[index];
						if (item && current) current.replaceWith(makeSeriesBlock(item, index === 0, true));
						else if (hiddenFallbacks.includes(tag)) current?.remove();
					});
					continue;
				}

				if (!tagOrder.includes(mode as Tag)) continue;
				const selected = orderedSeries(series, mode as Tag);
				if (selected.length > 0) gallery.replaceChildren(...selected.map((item, index) => makeSeriesBlock(item, index === 0)));
				else if (hiddenFallbacks.includes(mode as Tag)) gallery.replaceChildren();
				else makePreviewSeries(gallery, mode as Tag);
			}
		} catch {
			for (const gallery of galleries) {
				const mode = gallery.dataset.managedGallery;
				if (tagOrder.includes(mode as Tag)) makePreviewSeries(gallery, mode as Tag);
			}
		}
	}

	hydrateManagedGalleries();
</script>
