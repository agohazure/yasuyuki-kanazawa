---
const pathname = Astro.url.pathname;

const links = [
	{ href: '/#works', label: 'Works', active: pathname.startsWith('/works') },
	{ href: '/about/', label: 'About', active: pathname.startsWith('/about') },
	{ href: '/contact/', label: 'Contact', active: pathname.startsWith('/contact') },
];
---

<header class="site-header">
	<div class="site-header__inner container">
		<a class="wordmark" href="/" aria-label="Yasuyuki Kanazawa — Home">Yasuyuki Kanazawa</a>
		<nav aria-label="Main navigation">
			<ul>
				{links.map((link) => (
					<li>
						<a href={link.href} aria-current={link.active ? 'page' : undefined}>{link.label}</a>
					</li>
				))}
			</ul>
		</nav>
	</div>
</header>
