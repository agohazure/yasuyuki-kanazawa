---
const pathname = Astro.url.pathname;

const links = [
	{ href: '/#works', label: 'Works', active: pathname.startsWith('/works') },
	{ href: '/#about', label: 'About', active: pathname.startsWith('/about') },
	{ href: '/#contact', label: 'Contact', active: pathname.startsWith('/contact') },
];
---

<header class="site-header">
	<div class="site-header__inner container">
		<a class="wordmark" href="/" aria-label="Yasuyuki Kanazawa — Home">
			<span class="wordmark__desktop" aria-hidden="true">Yasuyuki Kanazawa</span>
			<span class="wordmark__mobile" aria-hidden="true">
				<span class="wordmark__line wordmark__line--expanded">
					<span>Y</span><span>a</span><span>s</span><span>u</span><span>y</span><span>u</span><span>k</span><span>i</span>
				</span>
				<span class="wordmark__line wordmark__line--natural">Kanazawa</span>
			</span>
		</a>
		<nav aria-label="Main navigation">
			<ul>
				{links.map((link) => (
					<li>
						<a href={link.href} aria-current={link.active ? 'page' : undefined}>{link.label}</a>
					</li>
				))}
			</ul>
		</nav>
	</div>
</header>
